# Google Analytics 4 measurement IDs for each domain
# Replace the placeholders with your actual GA4 Measurement IDs (G-XXXXXXX)
NEXT_PUBLIC_GA_MAIN=G-XXXXXXXX
NEXT_PUBLIC_GA_SKILLS=G-XXXXXXXX
NEXT_PUBLIC_GA_MEMBERS=G-XXXXXXXX

# Optional: fallback if hostname mapping fails
NEXT_PUBLIC_GA_FALLBACK=G-XXXXXXXX

# Note: Do NOT commit production secrets. Use your deployment platform's env settings.

# GA4 Data API (server-side) — numeric property IDs (not the G- measurement IDs)
# Example: GA_PROPERTY_MAIN=123456789
GA_PROPERTY_MAIN=YOUR_NUMERIC_PROPERTY_ID
GA_PROPERTY_SKILLS=YOUR_NUMERIC_PROPERTY_ID
GA_PROPERTY_MEMBERS=YOUR_NUMERIC_PROPERTY_ID

# Service account JSON for server-side GA Data API access. Put the full JSON content
# (as a single-line JSON string) into the environment variable below, or store it
# securely in your hosting provider's secret manager. Do NOT commit this to git.
# GA_SERVICE_ACCOUNT_KEY should contain the JSON service account key text.
GA_SERVICE_ACCOUNT_KEY={"type":"service_account", ... }
