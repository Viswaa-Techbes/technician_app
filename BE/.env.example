# Server
PORT=5000
NODE_ENV=development

# MongoDB — use either local or Atlas connection string
# Local example:
MONGODB_URI=mongodb://127.0.0.1:27017/technician_app
# Atlas SRV (default in Atlas UI):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/technician_app?retryWrites=true&w=majority
# If you get querySrv ECONNREFUSED, use Atlas "Standard connection string" (mongodb://host1:27017,host2:27017/...) instead — same .env key.

# JWT — use a long random secret in production (min 32 chars)
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d
